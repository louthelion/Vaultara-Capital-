import {createHash} from 'node:crypto';
import {getStore} from '@netlify/blobs';
import {deliver} from './_shared/deliver.mts';
export default async(req:Request)=>{const {payload}=await req.json();const source=String(payload?.form_name||payload?.name||payload?.data?.['form-name']||'');if(!/^vaultara/i.test(source))return;const input=payload.data||{};const data:any={};for(const k of ['full_name','name','first_name','last_name','first-name','last-name','email','phone','phone_number','phone-number','telephone','service','closest-area'])if(typeof input[k]==='string')data[k]=input[k].slice(0,300);const created=payload.created_at||new Date().toISOString();const id=String(payload.id||createHash('sha256').update(JSON.stringify({source,data,created})).digest('hex'));const submission={id,form_name:source,created_at:created,data};const store=getStore({name:'vaultara-intake-outbox',consistency:'strong'});const old=await store.get('receipts/'+id,{type:'json'}) as any;if(old?.deliveredAt)return;await store.setJSON('pending/'+id,{submission,queuedAt:new Date().toISOString()});try{await deliver(submission);await store.setJSON('receipts/'+id,{deliveredAt:new Date().toISOString()});await store.delete('pending/'+id);}catch{console.error('Vaultara intake queued for retry');}};
