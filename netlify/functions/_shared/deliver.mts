import {getStore} from '@netlify/blobs';
import {signSync} from './sync.mjs';
export async function deliver(record:any){const key=Netlify.env.get('VAULTARA_INTAKE_SYNC_KEY');if(!key)throw Error('Intake connection is not configured');const body=JSON.stringify(record);const timestamp=String(Date.now());const r=await fetch('https://vaultara-capital-dashboard.netlify.app/api/intake-sync',{method:'POST',headers:{'Content-Type':'application/json','x-vaultara-time':timestamp,'x-vaultara-signature':signSync(body,timestamp,key)},body,signal:AbortSignal.timeout(8000)});if(!r.ok)throw Error('Platform delivery not confirmed');}
export async function retryDeliveries(){const store=getStore({name:'vaultara-intake-outbox',consistency:'strong'});const {blobs}=await store.list({prefix:'pending/'});let sent=0;for(const b of blobs.slice(0,3)){const record=await store.get(b.key,{type:'json'}) as any;if(!record||record.deliveredAt)continue;try{await deliver(record.submission);await store.setJSON('receipts/'+record.submission.id,{deliveredAt:new Date().toISOString()});await store.delete(b.key);sent++;}catch{break;}}return sent;}
